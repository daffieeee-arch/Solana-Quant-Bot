{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/phase8d1-recovery-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "recoveryMode", "recoveryWorkflowSha", "imageSourceSha", "imageSourceAncestor", "originalPublishRunId",
    "originalArtifactsVerified", "originalHoldPreserved", "supersedesOriginalHoldWithoutDeletion",
    "rootCauseCategory", "originalArtifacts", "images", "packageMetadata", "runnerVerdict", "cockpitVerdict",
    "baseImageDriftVerdict", "cleanTreeVerdict", "zeroMutationEvidence", "zeroMutationDetails",
    "executionReasons", "verdict", "deploymentEligible", "recoveryCompleted", "reasons"
  ],
  "properties": {
    "schemaVersion": {"const": "PHASE8D1_RECOVERY_MANIFEST_1"},
    "recoveryMode": {"const": "EXISTING_DIGEST_READ_ONLY_RECOVERY"},
    "recoveryWorkflowSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "imageSourceSha": {"const": "9ed8d5b8d8b67284c8fc20c164f6816bbfc0c180"},
    "imageSourceAncestor": {"type": "boolean"},
    "originalPublishRunId": {"const": 32641496527},
    "originalArtifactsVerified": {"type": "boolean"},
    "originalHoldPreserved": {"type": "boolean"},
    "supersedesOriginalHoldWithoutDeletion": {"const": true},
    "rootCauseCategory": {"const": "PACKAGE_METADATA_API_EVIDENCE_NOT_PRODUCED_BEFORE_DIGEST_RETEST"},
    "originalArtifacts": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role","id","name","bytes","sha256","expectedVerdict"],
        "properties": {
          "role": {"type":"string","minLength":1,"maxLength":32},
          "id": {"type":"integer","minimum":1},
          "name": {"type":"string","minLength":1,"maxLength":160},
          "bytes": {"type":"integer","minimum":1,"maximum":1048576},
          "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
          "expectedVerdict": {"type":"string","minLength":1,"maxLength":80}
        }
      }
    },
    "images": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name","package","tag","expectedDigest","resolvedDigest","metadataStatus","packageExists","packageType","visibility","repositoryFullName","repositoryAccessVerified","unauthenticatedPullDenied","authenticatedPullSucceeded","platform","sourceGitSha","provenancePresent","spdxSbomPresent","digestRetestPassed"],
        "properties": {
          "name": {"enum":["cockpit","runner"]},
          "package": {"enum":["phase8a-research-cockpit","phase8a-bronze-runner"]},
          "tag": {"type":"string","minLength":80,"maxLength":240},
          "expectedDigest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
          "resolvedDigest": {"type":["string","null"],"pattern":"^sha256:[0-9a-f]{64}$"},
          "metadataStatus": {"type":"integer","minimum":0,"maximum":599},
          "packageExists": {"type":"boolean"},
          "packageType": {"type":["string","null"]},
          "visibility": {"type":["string","null"]},
          "repositoryFullName": {"type":["string","null"]},
          "repositoryAccessVerified": {"type":"boolean"},
          "unauthenticatedPullDenied": {"type":"boolean"},
          "authenticatedPullSucceeded": {"type":"boolean"},
          "platform": {"type":["string","null"]},
          "sourceGitSha": {"type":["string","null"],"pattern":"^[0-9a-f]{40}$"},
          "provenancePresent": {"type":"boolean"},
          "spdxSbomPresent": {"type":"boolean"},
          "digestRetestPassed": {"type":"boolean"},
          "imageConfig": {"type":"object"}
        }
      }
    },
    "packageMetadata": {"type":"array","minItems":0,"maxItems":2,"items":{"type":"object"}},
    "runnerVerdict": {"type":["string","null"]},
    "cockpitVerdict": {"type":["object","null"]},
    "baseImageDriftVerdict": {"enum":["PASS","HOLD"]},
    "cleanTreeVerdict": {"enum":["PASS","HOLD"]},
    "zeroMutationEvidence": {"type":"boolean"},
    "zeroMutationDetails": {
      "type":"object", "additionalProperties":false,
      "required":["imageBuild","imagePush","tagCreate","tagOverwrite","packageVersionDelete","packageSettingsChange"],
      "properties": {
        "imageBuild":{"const":false},"imagePush":{"const":false},"tagCreate":{"const":false},"tagOverwrite":{"const":false},"packageVersionDelete":{"const":false},"packageSettingsChange":{"const":false}
      }
    },
    "executionReasons": {"type":"array","maxItems":20,"items":{"type":"string","minLength":1,"maxLength":160}},
    "verdict": {"enum":["PUBLISH_SUCCEEDED","RECOVERY_HOLD"]},
    "deploymentEligible": {"type":"boolean"},
    "recoveryCompleted": {"type":"boolean"},
    "reasons": {"type":"array","maxItems":50,"items":{"type":"string","minLength":1,"maxLength":160}}
  }
}
