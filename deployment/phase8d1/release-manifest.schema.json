{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/daffieeee-arch/solana-paper-scanner/deployment/phase8d1/release-manifest.schema.json",
  "title": "Phase 8D1 synthetic image release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "status", "sourceGitSha", "workflowRunId", "workflowCommitSha",
    "builderRunnerImage", "platform", "runtimeIdentities", "baseImages", "prebuildHashes",
    "images", "runnerVerification", "cockpitVerification", "packageVisibility", "nonActions"
  ],
  "properties": {
    "schemaVersion": { "const": "PHASE8D1_RELEASE_MANIFEST_1" },
    "status": { "enum": ["VERIFY_ONLY_SUCCEEDED", "PUBLISH_SUCCEEDED"] },
    "sourceGitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "workflowRunId": { "type": "string", "pattern": "^[0-9]+$" },
    "workflowCommitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "builderRunnerImage": { "type": "string", "minLength": 1 },
    "platform": { "const": "linux/amd64" },
    "runtimeIdentities": {
      "type": "object", "additionalProperties": false,
      "required": ["runnerUid", "cockpitUid", "fixtureReadGid", "status"],
      "properties": {
        "runnerUid": { "const": 61000 }, "cockpitUid": { "const": 61001 },
        "fixtureReadGid": { "const": 61000 }, "status": { "const": "SELECTED_READ_ONLY_NOT_APPLIED" }
      }
    },
    "baseImages": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "registry", "repository", "versionTag", "manifestListDigest", "linuxAmd64Digest", "digestRef", "os", "architecture", "softwareVersion", "compressedSizeBytes", "observedAt"],
        "properties": {
          "name": { "enum": ["nodeBuilder", "nodeRuntime", "rust", "runnerRuntime"] },
          "registry": { "const": "docker.io" }, "repository": { "type": "string", "pattern": "^library/" },
          "versionTag": { "type": "string", "not": { "const": "latest" } },
          "manifestListDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "linuxAmd64Digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "digestRef": { "type": "string", "pattern": "^docker\\.io/library/[a-z0-9._-]+@sha256:[0-9a-f]{64}$" },
          "os": { "const": "linux" }, "architecture": { "const": "amd64" },
          "softwareVersion": { "type": "string", "minLength": 1 },
          "compressedSizeBytes": { "type": "integer", "minimum": 1, "maximum": 3221225472 },
          "observedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "prebuildHashes": {
      "type": "object", "additionalProperties": false,
      "required": ["packageLockSha256", "cargoLockSha256", "cockpitEntrypointSha256", "cockpitRuntimeTreeSha256", "cockpitFrontendTreeSha256", "runnerBinarySha256"],
      "properties": {
        "packageLockSha256": { "$ref": "#/$defs/sha256" }, "cargoLockSha256": { "$ref": "#/$defs/sha256" },
        "cockpitEntrypointSha256": { "$ref": "#/$defs/sha256" }, "cockpitRuntimeTreeSha256": { "$ref": "#/$defs/sha256" }, "cockpitFrontendTreeSha256": { "$ref": "#/$defs/sha256" },
        "runnerBinarySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "images": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "candidateTag", "imageId", "registryDigest", "inspectionVerdict", "ociProvenancePresent", "spdxSbomPresent", "finalDigestRetestVerdict"],
        "properties": {
          "name": { "enum": ["phase8a-research-cockpit", "phase8a-bronze-runner"] },
          "candidateTag": { "type": "string", "maxLength": 128, "not": { "pattern": "(?:^|:)latest$" } },
          "imageId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "registryDigest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
          "inspectionVerdict": { "const": "PASS" },
          "ociProvenancePresent": { "type": "boolean" }, "spdxSbomPresent": { "type": "boolean" },
          "finalDigestRetestVerdict": { "enum": ["NOT_APPLICABLE_VERIFY_ONLY", "PASS"] }
        }
      }
    },
    "runnerVerification": {
      "type": "object", "additionalProperties": false,
      "required": ["verdict", "independentRuns", "retainedFiles", "byteIdentical", "fixtureInputSha256", "perFileManifestSha256", "runId", "aggregateHash", "semanticRerunHash", "outboundDenied", "writeDenied", "orphanContainers"],
      "properties": {
        "verdict": { "const": "PASS" }, "independentRuns": { "const": 2 }, "retainedFiles": { "const": 20 }, "byteIdentical": { "const": true },
        "fixtureInputSha256": { "const": "a57dc097e4651d3fae4942e2a872d087ef1fb5265cde51a4a9e37e43a4671e82" },
        "perFileManifestSha256": { "const": "aa18a485c53caeb99098e366bce57d3f15d922bf8d60db60205d9c38d2aca258" },
        "runId": { "const": "phase8a-fixture-a57dc097e4651d3fae4942e2a872d087ef1fb5265cde51a4a9e37e43a4671e82" },
        "aggregateHash": { "const": "7123c27ffcfd3388b6fa2b98cc3c59be0b42028cf6778404ba645b83254f4791" },
        "semanticRerunHash": { "const": "94c954098b0bbf1b772932395333af28c1b5317c8e1c0f6c88381f0e2ab5e3b0" },
        "outboundDenied": { "const": true }, "writeDenied": { "const": true }, "orphanContainers": { "const": 0 }
      }
    },
    "cockpitVerification": {
      "type": "object", "additionalProperties": false,
      "required": ["unavailableVerdict", "providerVerdict", "outboundDenied", "outputUnchanged", "cleanShutdown"],
      "properties": {
        "unavailableVerdict": { "const": "PASS" }, "providerVerdict": { "const": "PASS" },
        "outboundDenied": { "const": true }, "outputUnchanged": { "const": true }, "cleanShutdown": { "const": true }
      }
    },
    "packageVisibility": { "enum": ["NOT_APPLICABLE_VERIFY_ONLY", "private"] },
    "nonActions": {
      "type": "object", "additionalProperties": false,
      "required": ["imagePush", "trueNasMutation", "datasetCreated", "deployment", "grafanaModified", "clickhouseModified", "payloadRetrieved", "pilotExecuted"],
      "properties": {
        "imagePush": { "type": "boolean" }, "trueNasMutation": { "const": false }, "datasetCreated": { "const": false },
        "deployment": { "const": false }, "grafanaModified": { "const": false }, "clickhouseModified": { "const": false },
        "payloadRetrieved": { "const": false }, "pilotExecuted": { "const": false }
      }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
