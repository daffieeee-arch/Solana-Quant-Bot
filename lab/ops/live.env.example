# ~/.config/solana-lab/live.env: non-secret settings of the live units (copy and edit).
# Paper (after the measuring hour; creation detection and budget as decided then). --pump-creates gives
# LiveFeed the creator of every token created after PAPER_STORE (F7's creator rule; ~0.1 GB/day): on only
# with the owner's OK.
RECORDER_ARGS="--pool-creations --new-reversed --pump-creates --budget-usd 2"
# The measuring hour (draaiboek meetuur), instead:
# RECORDER_ARGS="--pool-creations --new-reversed --pump-creates --max-runtime-secs 3600 --budget-usd 0.5 --no-downscale"
# Required (the engine refuses --live without it): tokens and pools known before the live start, and the
# farmer history of the day before. The newest forward store; a store ending long before the recorder's
# start leaves the pools created in between unknown (logged) and the farm labels incomplete for a day.
PAPER_STORE=/home/chupa/Solana-project/data-old-faithful-one/lab/store/fwd1053.duckdb
