        "uid": "${DS_CLICKHOUSE_OPS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE_OPS}"
