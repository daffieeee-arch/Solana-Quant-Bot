{
  "name": "solana-paper-scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "start:cockpit": "node dist/cockpit-main.js",
    "build": "tsc -p tsconfig.json && npm run verify:research-transport && npm run verify:phase8a-runner-offline && npm run build:frontend && npm run build:cockpit && npm run verify:phase8c-contracts && npm run verify:cockpit-runtime && npm run verify:phase8d1-supply-chain",
    "verify:research-transport": "node scripts/assert-research-transport-free.mjs",
    "verify:cockpit-runtime": "node scripts/assert-cockpit-runtime-inert.mjs",
    "verify:phase8c-contracts": "node scripts/assert-phase8c-contracts.mjs",
    "verify:phase8d1-supply-chain": "node scripts/phase8d1/assert-phase8d1-supply-chain.mjs",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "build:cockpit": "vite build --config frontend/vite.cockpit.config.ts",
    "research:pump-offline": "node dist/research/pump-historical-cli.js",
    "research:pilot-a:fixture": "cargo +1.97.1 run --quiet --locked --manifest-path rust/old-faithful-pump-reducer/Cargo.toml --bin phase8a-bronze-runner --",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci:policy": "node scripts/ci-repository-policy.mjs",
    "ci:research-citations": "node scripts/ci-research-citations.mjs",
    "verify:phase8a-runner-offline": "node scripts/assert-phase8a-runner-offline.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/fs-ext": "^2.0.3",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@msgpack/msgpack": "^3.1.3",
    "@solana/web3.js": "^1.98.4",
    "@titanexchange/sdk-ts": "^0.1.5",
    "@triton-one/vixen-stream": "^0.4.1",
    "@triton-one/yellowstone-grpc": "^5.0.9",
    "@types/bs58": "^4.0.4",
    "bs58": "^6.0.0",
    "fs-ext": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  }
}
